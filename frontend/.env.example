# URL base usada pelo Axios e pelo fetch SSE; incorporada no build Vite.
VITE_API_BASE_URL=/api/v1

# Alvo do proxy em desenvolvimento. O vite.config.ts atual lê process.env sem
# loadEnv; defina esta variável também no ambiente do processo que inicia o Vite.
VITE_API_PROXY_TARGET=http://localhost:8080
