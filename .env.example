# FinVise - variáveis consumidas pelo docker-compose.yml

# --------------------------------------------------
# Docker Compose
# --------------------------------------------------
COMPOSE_PROJECT_NAME=finvise

# --------------------------------------------------
# Frontend (build-time)
# --------------------------------------------------
VITE_API_BASE_URL=/api/v1

# --------------------------------------------------
# PostgreSQL
# --------------------------------------------------
POSTGRES_DB=finvise
POSTGRES_USER=finvise
# Obrigatório. Use o mesmo valor em SPRING_DATASOURCE_PASSWORD.
# No perfil production, o backend exige ao menos 16 caracteres e rejeita placeholders.
POSTGRES_PASSWORD=
PGDATA=/var/lib/postgresql/data/pgdata

# --------------------------------------------------
# Backend (Spring Boot)
# --------------------------------------------------
SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/finvise
SPRING_DATASOURCE_USERNAME=finvise
# Obrigatório. Deve ser igual a POSTGRES_PASSWORD na topologia padrão.
SPRING_DATASOURCE_PASSWORD=
# Obrigatório. Use ao menos 32 bytes aleatórios para a chave HMAC.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_CONNECT_TIMEOUT_MS=5000
AI_SERVICE_READ_TIMEOUT_MS=30000
SSE_TIMEOUT_MS=120000
RAG_INDEX_QUEUE_ENABLED=true
RAG_INDEX_QUEUE_POLL_DELAY_MS=1000
RAG_INDEX_QUEUE_LOCK_TIMEOUT_MS=120000
RAG_INDEX_QUEUE_MAX_ATTEMPTS=5
RAG_INDEX_QUEUE_RETRY_BASE_DELAY_MS=2000
RAG_INDEX_QUEUE_RETRY_MAX_DELAY_MS=60000

# --------------------------------------------------
# Uploads e armazenamento
# --------------------------------------------------
STORAGE_TYPE=local
STORAGE_LOCAL_BASE_PATH=/app/uploads

# Obrigatórias somente com STORAGE_TYPE=oci.
# O container também precisa enxergar o profile DEFAULT de ~/.oci/config;
# o Compose atual não monta essas credenciais.
OCI_NAMESPACE=
OCI_BUCKET_NAME=
OCI_REGION=us-ashburn-1

# --------------------------------------------------
# E-mail de redefinição de senha (Resend)
# --------------------------------------------------
# O backend inicia sem chave, mas a entrega de e-mail falhará de forma assíncrona.
RESEND_API_KEY=
RESEND_FROM_ADDRESS="Finance AI <no-reply@example.com>"

# --------------------------------------------------
# Open Finance (Pluggy)
# --------------------------------------------------
OPEN_FINANCE_PROVIDER=pluggy
OPEN_FINANCE_BASE_URL=https://api.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Encaminhada à Pluggy; este repositório não implementa um receptor de webhook.
OPEN_FINANCE_WEBHOOK_URL=
# URL HTTPS pública ou deep link aceito pela Pluggy.
OPEN_FINANCE_OAUTH_REDIRECT_URL=
OPEN_FINANCE_INCLUDE_SANDBOX=false

# --------------------------------------------------
# AI Service - modelos e logs
# --------------------------------------------------
MODELS_DIR=/app/models
TRANSACTION_MODEL_PATH=/app/models/transaction-classifier
PROFILE_MODEL_PATH=/app/models/profile-classifier
LOG_LEVEL=info

# ENVIRONMENT, REQUIRE_ACTIVE_MODELS e versões esperadas não são encaminhadas
# pelo Compose atual. Configure o ai-service isoladamente ou ajuste o Compose
# antes de depender da exigência de modelos em produção.

# --------------------------------------------------
# AI Service - LLM opcional
# --------------------------------------------------
ENABLE_LLM=false
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# O Compose converte LLM_TIMEOUT em LLM_TIMEOUT_SECONDS dentro do container.
LLM_TIMEOUT=30

# --------------------------------------------------
# AI Service - RAG
# --------------------------------------------------
# Embeddings remotos exigem true e LLM_API_KEY; sem isso, usa local-hash-v2.
RAG_ENABLE_REMOTE_EMBEDDINGS=true
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_BATCH_SIZE=200
RAG_INDEX_MAX_BATCHES=100
RAG_MIN_RELEVANCE=0.18

# --------------------------------------------------
# Nginx
# --------------------------------------------------
# Usada pelo Compose base. O override de produção publica 80:80.
NGINX_HTTP_PORT=8080
