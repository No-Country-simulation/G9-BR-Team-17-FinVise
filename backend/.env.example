# FinVise Backend - Variáveis de ambiente

# Spring
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
SERVER_CONTEXT_PATH=
MANAGEMENT_SERVER_PORT=8080

# Banco de dados
DATABASE_URL=jdbc:postgresql://localhost:5432/finvise
DATABASE_USERNAME=finvise
DATABASE_PASSWORD=finvise

# Segurança (JWT)
JWT_SECRET=change-me-in-production-finvise-jwt-secret-key-min-256-bits
JWT_EXPIRATION_MS=86400000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,http://163.176.174.219:8080

# Integração com AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_CONNECT_TIMEOUT_MS=5000
AI_SERVICE_READ_TIMEOUT_MS=30000

# Armazenamento de arquivos (local | oci)
STORAGE_TYPE=local
STORAGE_LOCAL_BASE_PATH=./uploads

# OCI Object Storage (obrigatório quando STORAGE_TYPE=oci)
OCI_NAMESPACE=
OCI_BUCKET_NAME=
OCI_REGION=
