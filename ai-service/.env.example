# AI Service — execução isolada

# --------------------------------------------------
# Ambiente e servidor
# --------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
# Obrigatório. Token Bearer compartilhado com o backend; use 32+ caracteres aleatórios.
AI_SERVICE_TOKEN=

# --------------------------------------------------
# PostgreSQL para RAG
# --------------------------------------------------
# Também é aceito DATABASE_URL. Host, porta e banco são extraídos da URL.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/finvise
SPRING_DATASOURCE_USERNAME=finvise
SPRING_DATASOURCE_PASSWORD=
# Fallbacks de usuário/senha quando SPRING_DATASOURCE_* não são definidos.
POSTGRES_USER=finvise
POSTGRES_PASSWORD=
RAG_DB_POOL_MIN_SIZE=0
RAG_DB_POOL_MAX_SIZE=10
RAG_DB_POOL_TIMEOUT_SECONDS=10

# --------------------------------------------------
# Modelos
# --------------------------------------------------
MODELS_DIR=models
TRANSACTION_MODEL_PATH=models/transaction-classifier
PROFILE_MODEL_PATH=models/profile-classifier
MODEL_EVALUATION_REPORT_DIR=reports/final-test
# true ou ENVIRONMENT=production/prod faz a inicialização falhar sem artefatos válidos.
REQUIRE_ACTIVE_MODELS=false
# Vazias desabilitam a validação de versão esperada.
TRANSACTION_MODEL_VERSION=
PROFILE_MODEL_VERSION=

# --------------------------------------------------
# LLM opcional
# --------------------------------------------------
ENABLE_LLM=false
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# --------------------------------------------------
# RAG
# --------------------------------------------------
# Remoto exige true e LLM_API_KEY; sem isso, o modelo efetivo é local-hash-v2.
RAG_ENABLE_REMOTE_EMBEDDINGS=true
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_BATCH_SIZE=200
RAG_INDEX_MAX_BATCHES=100
RAG_MIN_RELEVANCE=0.18

# --------------------------------------------------
# Agente
# --------------------------------------------------
AGENT_SYSTEM_PROMPT_PATH=app/agent/prompts/system_prompt.txt
# Estas flags existem nas settings, mas o orquestrador atual não as consulta.
AGENT_ENABLE_RECOMMENDATIONS=true
AGENT_ENABLE_SIMULATIONS=true

# --------------------------------------------------
# Dados de treinamento
# --------------------------------------------------
# Relativos ao diretório ai-service quando os comandos são executados dali.
DATASET_RAW_DIR=../finance_ai_dataset
DATA_PROCESSED_DIR=data/processed
DATA_SAMPLES_DIR=data/samples
