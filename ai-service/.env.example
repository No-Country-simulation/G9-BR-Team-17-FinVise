# AI Service — Finance AI
ENVIRONMENT=development
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Models
MODELS_DIR=models
TRANSACTION_MODEL_PATH=models/transaction-classifier
PROFILE_MODEL_PATH=models/profile-classifier
MODEL_EVALUATION_REPORT_DIR=reports/final-test

# LLM (optional; service works without a real LLM)
ENABLE_LLM=false
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# Agent
AGENT_SYSTEM_PROMPT_PATH=app/agent/prompts/system_prompt.txt
AGENT_ENABLE_RECOMMENDATIONS=true
AGENT_ENABLE_SIMULATIONS=true
