# --------------------------------------------------
# Application
# --------------------------------------------------
COMPOSE_PROJECT_NAME=finvise
APP_ENV=local
APP_VERSION=0.1.0

# --------------------------------------------------
# Frontend
# --------------------------------------------------
VITE_API_BASE_URL=/api/v1

# --------------------------------------------------
# Backend (Spring Boot)
# --------------------------------------------------
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/finvise
SPRING_DATASOURCE_USERNAME=finvise
# Obrigatório: use uma senha forte e mantenha o mesmo valor de POSTGRES_PASSWORD.
SPRING_DATASOURCE_PASSWORD=
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
# Obrigatório: gere um segredo aleatório com no mínimo 32 caracteres.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://163.176.174.219:8080
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_CONNECT_TIMEOUT_MS=5000
AI_SERVICE_READ_TIMEOUT_MS=30000
SSE_TIMEOUT_MS=120000
STORAGE_TYPE=local
STORAGE_LOCAL_BASE_PATH=/app/uploads

# --------------------------------------------------
# AI Service (FastAPI)
# --------------------------------------------------
AI_SERVICE_PORT=8000
MODELS_DIR=/app/models
TRANSACTION_MODEL_PATH=/app/models/transaction-classifier
PROFILE_MODEL_PATH=/app/models/profile-classifier
REQUIRE_ACTIVE_MODELS=true
TRANSACTION_MODEL_VERSION=1.1.0
PROFILE_MODEL_VERSION=1.0.0
LOG_LEVEL=info
ENABLE_LLM=false
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
RAG_ENABLE_REMOTE_EMBEDDINGS=true
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_BATCH_SIZE=200
RAG_INDEX_MAX_BATCHES=100
RAG_MIN_RELEVANCE=0.18

# --------------------------------------------------
# PostgreSQL
# --------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=finvise
POSTGRES_USER=finvise
# Obrigatório: use uma senha forte e mantenha o mesmo valor de SPRING_DATASOURCE_PASSWORD.
POSTGRES_PASSWORD=
PGDATA=/var/lib/postgresql/data/pgdata

# --------------------------------------------------
# Nginx
# --------------------------------------------------
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
SERVER_NAME=localhost

# --------------------------------------------------
# OCI (optional)
# --------------------------------------------------
OCI_REGION=us-ashburn-1
OCI_BUCKET_NAME=
OCI_NAMESPACE=
# Open Finance (Pluggy)
OPEN_FINANCE_PROVIDER=pluggy
OPEN_FINANCE_BASE_URL=https://api.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
OPEN_FINANCE_WEBHOOK_URL=
# Opcional: deve ser uma URL HTTPS pública ou um deep link aceito pela Pluggy.
OPEN_FINANCE_OAUTH_REDIRECT_URL=
OPEN_FINANCE_INCLUDE_SANDBOX=false
