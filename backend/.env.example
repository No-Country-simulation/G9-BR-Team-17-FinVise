# FinVise Backend - execução isolada

# --------------------------------------------------
# Spring / servidor
# --------------------------------------------------
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
SERVER_CONTEXT_PATH=
MANAGEMENT_SERVER_PORT=8080

# --------------------------------------------------
# PostgreSQL
# --------------------------------------------------
# application.yml referencia DATABASE_*; variáveis SPRING_DATASOURCE_* também
# podem sobrescrever diretamente propriedades Spring Boot.
DATABASE_URL=jdbc:postgresql://localhost:5432/finvise
DATABASE_USERNAME=finvise
DATABASE_PASSWORD=
# Quantidade máxima de inserts/updates agrupados por lote pelo Hibernate.
HIBERNATE_JDBC_BATCH_SIZE=100

# --------------------------------------------------
# JWT e CORS
# --------------------------------------------------
# Obrigatório fora do fallback local. Use ao menos 32 bytes aleatórios.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# --------------------------------------------------
# AI Service
# --------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_CONNECT_TIMEOUT_MS=5000
AI_SERVICE_READ_TIMEOUT_MS=30000
SSE_TIMEOUT_MS=120000
RAG_INDEX_QUEUE_ENABLED=true
RAG_INDEX_QUEUE_POLL_DELAY_MS=1000
RAG_INDEX_QUEUE_LOCK_TIMEOUT_MS=120000
RAG_INDEX_QUEUE_MAX_ATTEMPTS=5
RAG_INDEX_QUEUE_RETRY_BASE_DELAY_MS=2000
RAG_INDEX_QUEUE_RETRY_MAX_DELAY_MS=60000

# --------------------------------------------------
# Open Finance (Pluggy)
# --------------------------------------------------
OPEN_FINANCE_PROVIDER=pluggy
OPEN_FINANCE_BASE_URL=https://api.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Encaminhada à Pluggy; o backend atual não recebe webhooks.
OPEN_FINANCE_WEBHOOK_URL=
OPEN_FINANCE_OAUTH_REDIRECT_URL=
OPEN_FINANCE_INCLUDE_SANDBOX=false

# --------------------------------------------------
# Armazenamento de CSV importado (local | oci)
# --------------------------------------------------
STORAGE_TYPE=local
STORAGE_LOCAL_BASE_PATH=./uploads

# Obrigatórias com STORAGE_TYPE=oci. O SDK também lê o profile DEFAULT de
# ~/.oci/config do usuário que executa o processo.
OCI_NAMESPACE=
OCI_BUCKET_NAME=
OCI_REGION=

# --------------------------------------------------
# Redefinição de senha (Resend)
# --------------------------------------------------
# Sem chave válida, o endpoint responde normalmente, mas o envio assíncrono falha.
RESEND_API_KEY=
RESEND_FROM_ADDRESS="Finance AI <no-reply@example.com>"
